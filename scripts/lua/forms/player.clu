MobDropCtl = {}
for i = 0, 14 do
	local fora = 0
	if i >= 10 then fora = 5000 end
	listMobDrops = UI_CreateCompent(frmMonsterInfo, COMMAND_ONE_TYPE, "listMobDrops"..i, 170, 37, 25, 56 + (i * 40) + fora)
	table.insert(MobDropCtl, listMobDrops)
	UI_SetIsDrag(listMobDrops, TRUE)

	LabMobItems = UI_CreateCompent(frmMonsterInfo, LABELEX_TYPE, "LabMobItems"..i, 94, 12, 62, 59 + (i * 40) + fora)
	table.insert(MobDropCtl, LabMobItems)
	UI_SetTextColor(LabMobItems, 4293976766)
	UI_SetLabelExFont(LabMobItems, DEFAULT_FONT, TRUE, COLOR_BLACK)

	LabMobRates = UI_CreateCompent(frmMonsterInfo, LABELEX_TYPE, "LabMobRates"..i, 94, 12, 62, 74 + (i * 40) + fora)
	table.insert(MobDropCtl, LabMobRates)
	UI_SetTextColor(LabMobRates, 4288665738)
	UI_SetLabelExFont(LabMobRates, DEFAULT_FONT, TRUE, COLOR_BLACK)
	
	checkDropFilter = UI_CreateCompent(frmMonsterInfo, CHECK_TYPE, "checkDropFilter"..i, 10, 10,  160, 68 + (i * 40) + fora)
	table.insert(MobDropCtl, checkDropFilter)
	UI_LoadImage(checkDropFilter, "texture/ui/corsairs/monstro.png", UNCHECKED, 10, 10, 412, 473)
	UI_LoadImage(checkDropFilter, "texture/ui/corsairs/monstro.png", CHECKED, 10, 10, 393, 473)
end

