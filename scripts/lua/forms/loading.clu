-----------------------------------------------------------------------
-- 定义loading表单
-----------------------------------------------------------------------	
-- 创建loading表单
frmLoading = UI_CreateForm( "frmLoading", FALSE, 1366, 768, 0, 0, FALSE, FALSE )
--UI_LoadFormImage( frmLoading, "texture/ui/loading.bmp", 1024, 768, 0, 0, "", 0, 0 )
UI_SetFormStyle( frmLoading , 8 )
UI_ShowForm( frmLoading, TRUE )
UI_AddFormToTemplete( frmLoading, FORM_SWITCH_SCENE )
UI_FormSetIsEscClose( frmLoading, FALSE )













--定义进度条
imgLoadingA = UI_CreateCompent( frmLoading, IMAGE_TYPE, "imgLoadingA", 1024, 768, 0, 0 )
UI_LoadImage( imgLoadingA, "texture/ui/loading/full_a.tga", NORMAL, 1024, 768, 0, 0 )
imgLoadingB = UI_CreateCompent( frmLoading, IMAGE_TYPE, "imgLoadingB", 342, 768, 1024, 0 )
UI_LoadImage( imgLoadingB, "texture/ui/loading/full_b.tga", NORMAL, 342, 768, 0, 0 )
imgLoading = UI_CreateCompent( frmLoading, IMAGE_TYPE, "imgLoading", 140, 30, 232, 700 )
UI_LoadImage( imgLoading, "texture/ui/LoadProgress.tga", NORMAL, 140, 30, 0, 0 )

--定义说明
labLoad= UI_CreateCompent( frmLoading, LABELEX_TYPE, "labLoad", 80, 13, 650, 744 )
UI_SetCaption( labLoad, "Loading…" )
UI_SetTextColor( labLoad, COLOR_YELLOW )
UI_SetLabelExFont( labLoad, DEFAULT_FONT, TRUE, COLOR_BLACK)
-----------------------------------------------------------------------
-- 定义连接服务器表单
-----------------------------------------------------------------------	
-- 创建连接服务器表单
frmConnect = UI_CreateForm( "frmConnect", FALSE, 300, 72, 533, 340, FALSE, FALSE )
UI_LoadFormImage( frmConnect, "texture/ui/ods/loginbox.tga", 300, 72, 0, 270, "", 0, 0 )
--UI_FormSetHotKey( frmConnect, ALT_KEY, HOTKEY_L ) 
UI_SetFormStyle( frmConnect, 1 )
UI_AddFormToTemplete( frmConnect, FORM_SWITCH_SCENE )
UI_FormSetIsEscClose( frmConnect, FALSE )

--创建连接信息
labConnect = UI_CreateCompent( frmConnect, LABELEX_TYPE, "labConnect", 120, 13, 110, 18 )
UI_SetCaption( labConnect, "Please wait…" )
UI_SetTextColor( labConnect, COLOR_YELLOW )
UI_SetLabelExFont( labConnect, DEFAULT_FONT, TRUE, COLOR_BLACK )

--创建loading进度
imgLoading = UI_CreateCompent( frmConnect, IMAGE_FLASH_TYPE, "imgLoading", 260, 10, 20, 46 )
UI_LoadScaleImage( imgLoading, "texture/ui/ods/loginbox.tga", 0, 260, 10, 0, 350, 1.0, 1.0 )



-----------------------------------------------------------------------
-- 定义界面说明表单
-----------------------------------------------------------------------	
-- 创建界面说明表单
frmVHelp = UI_CreateForm( "frmVHelp", FALSE, 1366, 768, 0, 0, TRUE, FALSE )
UI_AddFormToTemplete( frmVHelp, FORM_MAIN )
UI_ShowForm( frmVHelp, TRUE )
UI_FormSetIsEscClose( frmVHelp, FALSE )
imgDicas = UI_CreateCompent( frmVHelp, IMAGE_TYPE, "imgDicas", 1366, 768, 0, 0 )
UI_LoadImage( imgDicas, "texture/ui/corsairs/dicas.png", NORMAL, 1366, 768, 0, 0 )
--UI_FormSetHotKey( frmVHelp, ALT_KEY, HOTKEY_U )















--创建关闭按钮
btnClose = UI_CreateCompent( frmVHelp, BUTTON_TYPE, "btnClose", 140, 40, 613, 400 )
UI_LoadButtonImage( btnClose, "texture/ui/corsairs/dicas.png", 140, 40, 0, 780, TRUE )

-- Tales of Corsairs: controle novo da versao DX9 (imgProgressLoad), copiado da interface da fonte.
imgProgressLoad = UI_CreateCompent(frmLoading, IMAGE_TYPE, "imgProgressLoad", 1338, 180, 294, 122)
UI_LoadImage(imgProgressLoad, "texture/ui/imgProgressLoad.png", NORMAL, 854, 180, 0, 37)
UI_SetIsShow( imgProgressLoad, FALSE )
-- Tales of Corsairs: controle novo da versao DX9 (labTip), copiado da interface da fonte.
labTip = UI_CreateCompent(frmLoading, LABELEX_TYPE, "labTip", 800, 13, 220, 750)
UI_SetCaption(labTip, "2. This is second tip, you can click ALT + E to open inventory")
UI_SetTextColor(labTip, COLOR_WHITE)
UI_SetLabelExFont(labTip, TIPFONT, FALSE, COLOR_WHITE)
UI_SetIsShow( labTip, FALSE )
-- Tales of Corsairs: controle novo da versao DX9 (imgLoadingBg), copiado da interface da fonte.
imgLoadingBg = UI_CreateCompent(frmLoading, IMAGE_TYPE, "imgLoadingBg", 1920, 1080, 0, 0)
UI_LoadImage(imgLoadingBg, "texture/ui/LOADING/LoadBgScene.jpg", NORMAL, 1920, 1080, 0, 0)
UI_SetIsShow( imgLoadingBg, FALSE )
-- Tales of Corsairs: controle novo da versao DX9 (imgProgressBar), copiado da interface da fonte.
imgProgressBar = UI_CreateCompent(frmLoading, IMAGE_TYPE, "imgProgressBar", 854, 180, 294, 122)
UI_LoadImage(imgProgressBar, "texture/ui/imgProgressBar.png", NORMAL, 854, 180, 0, 0)
UI_SetIsShow( imgProgressBar, FALSE )
