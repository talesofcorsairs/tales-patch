COLOR_CHA_VALUE = 4293981439
COLOR_CHA_GOLD = 4294955883
frmState = UI_CreateForm( "frmState", FALSE, 240, 424, 0, 120, TRUE, FALSE )
UI_FormSetHotKey( frmState, ALT_KEY, HOTKEY_A )
UI_ShowForm( frmState, FALSE )
UI_AddFormToTemplete( frmState, 1 )
UI_SetIsDrag( frmState, TRUE )
--UI_SetFormStyle( frmState, 0 )
--UI_SetAlpha( frmState, 200 )

-- 加载背景图片
imgBakTop = UI_CreateCompent( frmState, IMAGE_TYPE, "imgBakTop", 240, 424, 0, 0 )
UI_LoadImage( imgBakTop, "texture/ui/ods/PublicD2.tga", NORMAL, 240, 424, 0, 0 )

