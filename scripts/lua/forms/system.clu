-- 定义系统 System options window
-----------------------------------------------------------------------

-- 创建系统表单
frmSystem = UI_CreateForm( "frmSystem", FALSE, 190, 274, 150, 200, TRUE, FALSE )
UI_FormSetHotKey( frmSystem, ALT_KEY, HOTKEY_O ) --'O'
UI_ShowForm( frmSystem, TRUE )
UI_AddFormToTemplete( frmSystem, 1 )
UI_SetIsDrag( frmSystem, TRUE )
UI_SetFormStyle( frmSystem, 0 )
UI_SetAlpha( frmSystem, 235 )


--创建系统背景
imgSystemT = UI_CreateCompent( frmSystem, IMAGE_TYPE, "imgSystemT", 190, 309, 0, 0 )
UI_LoadImage( imgSystemT, "texture/ui/ods/system1.tga", NORMAL, 190, 309, 0, 0 )


--创建关闭按钮
btnClose = UI_CreateCompent( frmSystem, BUTTON_TYPE, "btnClose", 14, 14, 169, 3 )
UI_LoadButtonImage( btnClose, "texture/ui/ods/PublicC.tga", 14, 14, 116, 175, TRUE )
UI_SetButtonModalResult( btnClose, BUTTON_CLOSE )

--创建视频按钮
btnVideo = UI_CreateCompent( frmSystem, BUTTON_TYPE, "btnVideo", 121, 26, 35, 66 )
UI_LoadButtonImage( btnVideo, "texture/ui/ods/SysBotton1.tga", 121, 26, 0, 0, FALSE )

--创建音频按纽
