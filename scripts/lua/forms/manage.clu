frmManage = UI_CreateForm( "frmManage", FALSE, 456, 373, 200, 200, TRUE, FALSE )
UI_FormSetHotKey( frmManage, ALT_KEY, HOTKEY_C )
UI_ShowForm( frmManage, FALSE )
