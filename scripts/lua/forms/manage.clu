local perms = { "Speak", "Manage Permissions", "View Bank", "Deposit Bank", "Withdraw Bank", "Recruit", "Kick", "Change Motto", "Disband Guild", "Leader" }

trvEditor = UI_CreateCompent( frmGuildPerm, TREE_TYPE, "trvEditor", 180, 200, 0, 35 )
for i,v in ipairs(perms) do
	itemid = UI_CreateTextItem( v, COLOR_RED )
	sndNode = UI_CreateSingleNode( trvEditor, itemid, -1 )
end
UI_SetIsDrag( trvEditor, TRUE )
UI_TreeLoadImage( trvEditor, enumTreeAddImage, "texture/ui/QQ2.tga", 20,16,85,222, 20, 16)
UI_TreeLoadImage( trvEditor, enumTreeSubImage, "texture/ui/QQ2.tga", 20,16,85,240, 20, 16)
scrollid = UI_GetScroll( trvEditor )
UI_SetSize( scrollid, 11, 1 )
UI_LoadImage( scrollid, "texture/ui/PublicC.tga", COMPENT_BACK, 11, 1, 194, 13 )
id = UI_GetScrollObj( scrollid, SCROLL_UP )
UI_LoadButtonImage( id, "texture/ui/PublicC.tga", 11, 9, 166, 0, TRUE )
UI_SetSize( id, 11, 9 )
id = UI_GetScrollObj( scrollid, SCROLL_SCROLL )
UI_LoadImage( id, "texture/ui/PublicC.tga", COMPENT_BACK, 11, 43, 166, 10 )
UI_SetSize( id, 11, 43 )
id = UI_GetScrollObj( scrollid, SCROLL_DOWN )
UI_LoadButtonImage( id, "texture/ui/PublicC.tga", 11, 9, 166, 0, TRUE )
UI_SetSize( id, 11, 9 )

-- cargos prontos (Admin, Leader, Builder, Banker, Trusted, Member) acima do botao Presets
btnPredef = UI_CreateCompent( frmGuildPerm, BUTTON_TYPE, "btnPredef", 41, 19, 36, 254 )
UI_LoadButtonImage( btnPredef, "texture/ui/corsairs/guilda_pk.png", 41, 19, 570, 440, TRUE )
for i = 1,6 do
	predef = UI_CreateCompent( frmGuildPerm, BUTTON_TYPE, "btnPredef"..i, 41, 19, 36, 254-(19*i) )
	UI_LoadImage( predef, "texture/ui/corsairs/guilda_pk.png", 0, 41, 19, 570 + (i-1) * 41, 500 )
	UI_LoadImage( predef, "texture/ui/corsairs/guilda_pk.png", 2, 41, 19, 570 + (i-1) * 41, 519 )
	UI_LoadImage( predef, "texture/ui/corsairs/guilda_pk.png", 1, 41, 19, 570 + (i-1) * 41, 538 )
	UI_SetIsShow( predef, 0 )
end
